generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum DonationStatus {
  AVAILABLE
  OUT_OF_STOCK
  EXPIRED
}

enum ReportReason {
  ILLEGAL_ITEM
  DANGEROUS_ITEM
  FRAUD
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  isActive     Boolean    @default(true)
  donations    Donation[]
  reports      Report[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@index([isActive])
}

model Donation {
  id          String         @id @default(cuid())
  ownerId     String
  title       String
  description String?
  category    String
  quantity    Int
  latitude    Float
  longitude   Float
  address     String?
  startDate   DateTime
  endDate     DateTime
  status      DonationStatus @default(AVAILABLE)
  isHidden    Boolean        @default(false)
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images      DonationImage[]
  reports     Report[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerId])
  @@index([status, isHidden])
  @@index([category])
  @@index([startDate, endDate])
  @@index([latitude, longitude])
}

model DonationImage {
  id         String   @id @default(cuid())
  donationId String
  imageUrl   String
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([donationId])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  donationId  String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  donation    Donation     @relation(fields: [donationId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([reporterId])
  @@index([donationId])
  @@index([status])
}
