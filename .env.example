# Startup modes:
# Dev:  docker compose -f dokcer-compose.dev.yaml up -d
# Prod: docker compose up -d
# Both run Prisma migrate deploy, but NEVER run first-Admin bootstrap or demo seed.
# Both Compose files pin NODE_ENV independently; this value is for running Node directly.
# First ADMIN is created manually via docker compose [-f ...] exec backend npm run admin:bootstrap
# See docs/docker-admin-setup.md for exact commands, backup and credential handling.
FRONTEND_PORT=3000
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
# Used when running Backend directly; Docker Compose uses the internal `db` service URL.
DATABASE_URL=postgresql://ogtb:ogtb@localhost:5432/ogtb_donation_map?schema=public
# Replace before Production startup with a UNIQUE random secret (32+ characters).
# This is NOT a production-safe value.
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
ROUTING_BASE_URL=https://router.project-osrm.org
# Docker/Node 24 workaround for intermittent OSRM IPv4/IPv6 connection timeouts.
# Leave false outside environments that reproduce the issue.
DISABLE_AUTO_SELECT_FAMILY=false
# First ADMIN is created only via interactive `npm run admin:bootstrap` (NOT from env or seed).
# SEED_ADMIN_PASSWORD is no longer supported; do not configure it.
# Optional: manual demo USER seed in development only; fails in NODE_ENV=production.
# This variable does NOT create an Admin or enable automatic seeding.
SEED_USER_PASSWORD=replace-for-local-user
