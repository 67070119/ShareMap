FRONTEND_PORT=3000
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
# Used when running Backend directly; Docker Compose uses the internal `db` service URL.
DATABASE_URL=postgresql://ogtb:ogtb@localhost:5432/ogtb_donation_map?schema=public
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
ROUTING_BASE_URL=https://router.project-osrm.org
# Docker/Node 24 workaround for intermittent OSRM IPv4/IPv6 connection timeouts.
# Leave false outside environments that reproduce the issue.
DISABLE_AUTO_SELECT_FAMILY=false
SEED_ADMIN_PASSWORD=replace-for-local-admin
SEED_USER_PASSWORD=replace-for-local-user
